ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.22
ARG BASE_REGISTRY=
ARG PYTHON_IMAGE=library/python:3.12-slim-bookworm
FROM ${UV_IMAGE} AS uv

FROM ${BASE_REGISTRY}${PYTHON_IMAGE}

ARG IVOLC_APT_MIRROR=https://mirrors.ivolces.com
ARG IVOLC_PYPI_INDEX=https://mirrors.ivolces.com/pypi/simple/
ENV UV_INDEX_URL=${IVOLC_PYPI_INDEX} \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN set -eux; \
    mirror="${IVOLC_APT_MIRROR%/}"; mirror="${mirror%/debian}"; \
    sed -i -E "s#https?://deb.debian.org#${mirror}#g" /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates fuse3 tini; \
    rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY lance-mcp/pyproject.toml lance-mcp/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY lance-mcp/ ./

RUN .venv/bin/python -m py_compile *.py && \
    .venv/bin/python test_chunk.py && \
    .venv/bin/python test_server.py

EXPOSE 5102
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD [".venv/bin/python", "server.py", "--help"]
