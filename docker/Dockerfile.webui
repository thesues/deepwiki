ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.8.22
FROM ${UV_IMAGE} AS uv

ARG BASE_REGISTRY=
ARG PYTHON_IMAGE=library/python:3.12-slim-bookworm
FROM ${BASE_REGISTRY}${PYTHON_IMAGE}

ARG APT_MIRROR=
ARG PIP_INDEX_URL=https://pypi.org/simple/
ENV UV_INDEX_URL=${PIP_INDEX_URL} \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN set -eux; \
    if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources || true; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates fuse3 tini; \
    rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY lance-mcp/pyproject.toml lance-mcp/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY lance-mcp/ ./

RUN .venv/bin/python -m py_compile *.py && \
    .venv/bin/python test_chunk.py && \
    .venv/bin/python test_server.py

EXPOSE 5102
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD [".venv/bin/python", "server.py", "--help"]
