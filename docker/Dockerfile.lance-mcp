ARG BASE_REGISTRY=
ARG PYTHON_IMAGE=library/python:3.12-slim-bookworm
FROM ${BASE_REGISTRY}${PYTHON_IMAGE}

ARG IVOLC_APT_MIRROR=https://mirrors.ivolces.com
ARG IVOLC_PYPI_INDEX=https://mirrors.ivolces.com/pypi/simple/
ENV PIP_INDEX_URL=${IVOLC_PYPI_INDEX} \
    UV_INDEX_URL=${IVOLC_PYPI_INDEX} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN set -eux; \
    mirror="${IVOLC_APT_MIRROR%/}"; mirror="${mirror%/debian}"; \
    sed -i -E "s#https?://deb.debian.org#${mirror}#g" /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates fuse3 tini; \
    rm -rf /var/lib/apt/lists/*

# Match the existing Buda image: bootstrap the uv tool in the cached Python
# base, then let uv install every project dependency from the locked graph.
RUN python -m pip install --no-cache-dir "uv==0.8.22"
WORKDIR /app
COPY lance-mcp/pyproject.toml lance-mcp/uv.lock ./
# The ivolc mirror owns its artifact URLs; a lock generated against PyPI cannot
# be made valid by rewriting the hostname. Refresh once inside the Volc build
# network, then install the exact graph that refresh produced.
RUN uv lock --refresh && uv sync --frozen --no-dev --no-install-project
COPY lance-mcp/*.py lance-mcp/README.md ./

RUN .venv/bin/python -m py_compile *.py && \
    .venv/bin/python test_chunk.py && \
    .venv/bin/python test_server.py

EXPOSE 5102
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD [".venv/bin/python", "server.py", "--help"]
