# Load in your normal shell; credentials remain in shell environment.
: "${ARK_API_KEY:?Export ARK_API_KEY before loading this file}"
ARK_DOUBAO_MODEL='doubao-seed-2-1-pro-260915'
ARK_DEEPSEEK_MODEL='deepseek-v4-1-flash-261017'
ARK_GLM_MODEL='glm-5-3-flash-260828'
COMPLEX_HOME="$PWD/.research-local/complex-kanban"
# Reuse the ordinary Agent's existing tools, MCP, skills and identity.
COMPLEX_SINGLE_HOME="$PWD/.research-local/chat-home"
COMPLEX_MODELS_FILE="$PWD/complex/models.example.json"
COMPLEX_MAX_WORKERS=3
COMPLEX_BASELINES_DIR="$PWD/.research-local/baselines"
COMPLEX_PORT=8081
HOST=127.0.0.1
WEBUI_LOCAL_MODE=1
AUTH_JWKS_URL=''
AUTH_USER=''
AUTH_PASS=''
MEDIA_USE_S3=0
HERMES_NO_DEP_INSTALL=1
HERMES_DISABLE_LAZY_INSTALLS=1
