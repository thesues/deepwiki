# The corpus itself is not source: 17 converted markdown files (~6 MB) that live
# in the autumn cluster under fs/docs/buda/. Keeping a second copy here would
# invite the two drifting.
md/
*.epub
*.pdf
__pycache__/

# vim swap files. One got committed by a `git add -A` (16b386d) and had to be
# removed again; the pattern costs nothing and that mistake is silent.
.*.sw[op]
